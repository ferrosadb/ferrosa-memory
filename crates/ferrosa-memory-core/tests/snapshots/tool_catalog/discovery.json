[
  {
    "name": "all_tools",
    "description": "Search and page through the Ferrosa Memory tool catalog when the compact default tools are not enough. Use compact discovery first, then request schema detail by exact name.",
    "inputSchema": {
      "properties": {
        "categories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array",
          "uniqueItems": true
        },
        "cursor": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "detail": {
          "default": "compact",
          "enum": [
            "compact",
            "schema"
          ],
          "type": "string"
        },
        "names": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        },
        "query": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  }
]
