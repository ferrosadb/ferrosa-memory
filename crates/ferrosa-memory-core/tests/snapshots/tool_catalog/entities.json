[
  {
    "name": "upsert",
    "description": "Writes a discovered named entity to the entity store. Deduplicates via phonetic matching.\n\nCALL WHEN: Any time you identify a named entity (person, place, org, event, concept) from content.\nCheck is_new in response: if false, entity already exists — use the returned entity_id to attach new facts.\n\nNote: source_fold_id is optional — omit if not in a fold context.",
    "inputSchema": {
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "context_snippet": {
          "maxLength": 4096,
          "type": "string"
        },
        "embedding": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "entity_name": {
          "maxLength": 512,
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "person",
            "place",
            "organization"
          ],
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "source_fold_id": {
          "description": "Optional: fold UUID from start_fold. Omit if not in a fold context.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "entity_name",
        "entity_type",
        "context_snippet"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  },
  {
    "name": "ingest_batch",
    "description": "Batch ingest multiple entities in a single call.\n\nCALL WHEN:\n- Ingesting 5+ entities at once (codebase indexing, document extraction, bulk import)\n- Performance matters — single round-trip instead of N sequential calls\n\nEach entity follows the same schema as upsert_entity. Returns array of results.\n\nCost: ~15ms + 5ms per entity (vs 15ms per entity with individual calls).",
    "inputSchema": {
      "properties": {
        "entities": {
          "description": "Array of entities to ingest",
          "items": {
            "properties": {
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "context_snippet": {
                "maxLength": 4096,
                "type": "string"
              },
              "entity_name": {
                "maxLength": 512,
                "type": "string"
              },
              "entity_type": {
                "enum": [
                  "person",
                  "place",
                  "organization"
                ],
                "type": "string"
              }
            },
            "required": [
              "entity_name",
              "entity_type",
              "context_snippet"
            ],
            "type": "object"
          },
          "maxItems": 100,
          "type": "array"
        },
        "session_id": {
          "description": "Session UUID",
          "type": "string"
        }
      },
      "required": [
        "entities"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  },
  {
    "name": "entities_update",
    "description": "Batch update entities by entity_id with explicit patch fields.\n\nReturns per-row success/failure and supports partial update.",
    "inputSchema": {
      "properties": {
        "entities": {
          "description": "Array of entity patches keyed by entity_id",
          "items": {
            "properties": {
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "context_snippet": {
                "maxLength": 4096,
                "type": "string"
              },
              "description": {
                "maxLength": 4096,
                "type": "string"
              },
              "embedding": {
                "description": "Replacement embedding vector",
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "entity_id": {
                "type": "string"
              },
              "entity_name": {
                "maxLength": 512,
                "type": "string"
              },
              "entity_type": {
                "type": "string"
              },
              "properties": {
                "type": "object"
              },
              "source_fold_id": {
                "type": "string"
              },
