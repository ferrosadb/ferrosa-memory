          "type": "string"
        },
        "note_id": {
          "type": "string"
        },
        "recipient_account_id": {
          "type": "string"
        },
        "successful_read_limit": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "note_id",
        "recipient_account_id"
      ],
      "type": "object"
