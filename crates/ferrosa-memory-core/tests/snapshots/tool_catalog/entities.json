  {
    "name": "list",
    "description": "List entities with structured equality predicates over entity fields and properties. Use this for kanban/task-style queries such as all task entities with status=ready and assignee=claude; use hybrid_search for semantic recall.",
    "inputSchema": {
      "properties": {
        "entity_type": {
          "description": "Optional entity_type filter, e.g. task",
          "type": "string"
        },
        "filters": {
          "description": "Equality predicates. Known entity fields include entity_id/id, session_id, entity_name/name, entity_type, state, scope, tags, content_hash, confidence. Other keys match properties.<key>.",
          "type": "object"
        },
        "include_cross_session": {
          "description": "Compatibility flag. true is equivalent to scope=all; false is equivalent to scope=session when scope is omitted and requires session_id.",
          "type": "boolean"
        },
        "limit": {
          "description": "Max results to return (default 50)",
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "scope": {
          "description": "session=the supplied session_id; global=tenant global plus legacy nil session; both=session+global; all=tenant-wide scan. Default all; session_id alone never changes scope.",
          "enum": [
            "session",
            "global",
            "both",
            "all"
          ],
          "type": "string"
        },
        "session_id": {
          "description": "Session UUID to target only with scope=session. Supplying it alone does not change the tenant-wide default.",
          "type": "string"
        }
      },
      "required": [],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  },
  {
    "name": "duplicates",
    "description": "Scans a session's entities for potential duplicates using text similarity (Jaccard coefficient) on context snippets. Returns pairs above the threshold, sorted by similarity descending.\n\nCALL WHEN: After bulk entity ingestion, or when you suspect duplicate entities exist in a session. Useful before consolidation to identify merge candidates.\nDO NOT CALL: On sessions with very few entities (< 3). Use retrieve_entities with phonetic matching for single-entity dedup.\nCost: O(n^2) comparisons -- fast for <1000 entities per session.",
    "inputSchema": {
      "properties": {
        "session_id": {
          "type": "string"
        },
        "threshold": {
          "description": "Similarity threshold (0-1). Default: 0.7. Higher = fewer, more confident matches.",
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  }
]
