[
  {
    "name": "rules",
    "description": "CRUD for Datalog rule registry.\n\nCALL WHEN:\n- Adding custom inference rules\n- Listing active rules\n- Deprecating old rules\n\nCost: Low (registry operations).",
    "inputSchema": {
      "properties": {
        "action": {
          "description": "CRUD action",
          "enum": [
            "list",
            "get",
            "put",
            "deprecate"
          ],
          "type": "string"
        },
        "family": {
          "description": "Rule family (for list/put)",
          "type": "string"
        },
        "name": {
          "description": "Human-readable name (for put)",
          "type": "string"
        },
        "rule_body": {
          "description": "Datalog rule text (for put)",
          "type": "string"
        },
        "rule_id": {
          "description": "Rule ID (for get/put/deprecate)",
          "type": "string"
        },
        "rule_weight": {
          "description": "Rule confidence weight (default 1.0)",
          "type": "number"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  },
