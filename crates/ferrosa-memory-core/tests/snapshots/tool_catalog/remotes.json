            "required": [
              "kind",
              "namespace",
              "action"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "remote_id": {
          "format": "uuid",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "remote_id",
        "facts"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
