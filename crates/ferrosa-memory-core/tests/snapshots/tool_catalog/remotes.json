  {
    "name": "teach_query_stream",
    "description": "Teacher-side remote memory query stream. Returns a transport-neutral JSON event array beginning with a start event before retrieval completion; raw context/detail/skill output requires explicit grants.",
    "inputSchema": {
      "properties": {
        "grants": {
          "items": {
            "enum": [
              "raw_context",
              "detail",
              "skill"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "include_detail": {
          "type": "boolean"
        },
        "include_raw_context": {
          "type": "boolean"
        },
        "include_skill": {
          "type": "boolean"
        },
        "learner_instance_id": {
          "format": "uuid",
          "type": "string"
        },
        "max_items": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "namespaces": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "query": {
          "maxLength": 4096,
          "type": "string"
        },
        "query_embedding": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "remote_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "remote_id",
        "query"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  },
  {
    "name": "pull_preview",
    "description": "Learner-side remote memory pull preview. Verifies a signed teaching packet, evaluates dry-run import policy, and reports duplicate/conflict candidates without mutating local storage.",
    "inputSchema": {
