[
  {
    "name": "feedback_record",
    "description": "Record terse feedback about a remote-memory candidate, classify it into a structured Packet H signal, and persist a queryable feedback explanation under the authenticated tenant.",
    "inputSchema": {
      "properties": {
        "feedback": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "remote_id": {
          "type": "string"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        },
        "source_namespace": {
          "minLength": 1,
          "type": "string"
        },
        "target_id": {
          "description": "Remote item/entity/candidate UUID receiving feedback.",
          "type": "string"
        },
        "tenant_id": {
          "description": "Must match the authenticated tenant context.",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "remote_id",
        "target_id",
        "source_namespace",
        "scope",
        "feedback"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "properties": {
        "duration_ms": {
          "description": "Server-side tool execution duration in milliseconds.",
          "minimum": 0,
          "type": "integer"
        },
        "is_error": {
          "description": "False for successful tool results.",
          "type": "boolean"
        },
        "requested_tool": {
          "description": "Tool name requested by the client, after alias resolution.",
          "type": "string"
        },
        "tool": {
          "description": "Canonical tool name that handled the call.",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "requested_tool",
        "duration_ms",
        "is_error"
      ],
      "type": "object"
    }
  },
