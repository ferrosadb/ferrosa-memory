          "description": "Teacher InstancePublicIdentity used to verify signed_packet",
          "type": "object"
        },
        "query": {
          "maxLength": 4096,
          "type": "string"
        },
        "remote_id": {
          "format": "uuid",
          "type": "string"
        },
        "remote_name": {
          "maxLength": 256,
          "type": "string"
        },
        "signed_packet": {
          "description": "SignedEnvelope<TeachingPacket> from teach_query_stream or remote transport",
          "type": "object"
        }
      },
      "required": [
        "remote_id",
        "remote_name",
        "query",
        "public_identity",
        "signed_packet"
