<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ferrosa-memory.mcp</string>

  <key>ProgramArguments</key>
  <array>
    <string>__BINARY_PATH__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>FERROSA_MEMORY_CONFIG</key>
    <string>__REPO_ROOT__/.runtime/ferrosa-memory-http.toml</string>
    <key>CLAUDE_PROJECT_DIR</key>
    <string>__REPO_ROOT__</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/tmp/ferrosa-memory-mcp.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/ferrosa-memory-mcp.log</string>
</dict>
</plist>
